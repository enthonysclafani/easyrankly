<?xml version="1.0"?>
<ruleset name="EasyRankly">
	<description>Coding standard for EasyRankly.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tools/phpstan/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/fixtures/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="easyrankly"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="EasyRankly"/>
				<element value="easyrankly"/>
				<element value="erankly"/>
			</property>
		</properties>
	</rule>

	<!-- Classes in src/ follow PSR-4 file names (src/Redirects/Repository.php), not class-*.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
		<exclude-pattern>/tools/*</exclude-pattern>
	</rule>

	<!-- Tests define WordPress constants (WP_UNINSTALL_PLUGIN, WP_TESTS_*) and never ship. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- CLI tools and the test bootstrap run before WordPress loads: no WP_Filesystem, no escaping context. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tools/*</exclude-pattern>
		<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
	</rule>
</ruleset>
