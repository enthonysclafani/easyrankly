{
	"name": "easyrankly",
	"private": true,
	"description": "Admin assets of the EasyRankly WordPress plugin. Nothing here runs on the frontend.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build editor=./assets/src/editor/index.js languages=./assets/src/languages/index.js language-switcher=./assets/src/language-switcher/index.js agent=./assets/src/agent/index.js media-field=./assets/src/media-field/index.js",
		"start": "wp-scripts start editor=./assets/src/editor/index.js languages=./assets/src/languages/index.js language-switcher=./assets/src/language-switcher/index.js agent=./assets/src/agent/index.js media-field=./assets/src/media-field/index.js",
		"lint:js": "wp-scripts lint-js assets/src"
	},
	"devDependencies": {
		"@wordpress/scripts": "36.1.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "7.57.0",
		"@wordpress/block-editor": "18.1.0",
		"@wordpress/blocks": "16.2.0",
		"@wordpress/components": "42.0.0",
		"@wordpress/core-data": "8.2.0",
		"@wordpress/data": "10.57.0",
		"@wordpress/editor": "15.2.0",
		"@wordpress/element": "9.0.0",
		"@wordpress/i18n": "6.30.0",
		"@wordpress/media-utils": "5.57.0",
		"@wordpress/plugins": "7.57.0",
		"@wordpress/url": "4.57.0"
	}
}
