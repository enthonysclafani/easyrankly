# EasyRankly release excludes (dev-only files, never shipped in the distributable zip).
# Used by tools/build-dist.sh (and wp dist-archive if installed) and as reference for wordpress.org SVN deployments.
/.git
/.gitignore
/.github
/.delta
/.distignore
/.DS_Store
/.dist
/.erankly-audit
/.phpunit.result.cache
/phpunit.xml.dist
/composer.json
/composer.lock
/tests
/.playwright-cli
/tools
/vendor
/.commandcode
/WORDPRESS-ORG-READINESS.md
/report errori al 15-09-2026
/piano moduli contatto al 01-10-2026
