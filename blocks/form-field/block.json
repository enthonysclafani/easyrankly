{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "widgets",
  "textdomain": "easyrankly",
  "name": "easyrankly/form-field",
  "title": "Form Field",
  "description": "A field in an EasyRankly form.",
  "icon": "feedback",
  "attributes": {
    "type": {
      "type": "string",
      "default": "text"
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "help": {
      "type": "string",
      "default": ""
    },
    "autocomplete": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "options": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "erankly-form-field-editor",
  "editorStyle": "erankly-forms"
}
